# ============ Database ============
# 开发（默认 SQLite，可切换到 Docker Compose 起来的 PostgreSQL）
# DATABASE_URL=postgresql+psycopg://wali:wali_pwd@localhost:5432/wali_bell
DATABASE_URL=sqlite:///./wali_bell.db

# ============ JWT ============
JWT_SECRET_KEY=change-me-in-prod-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# ============ 服务端口 ============
# 后端 FastAPI 监听端口（沙箱内部）
BACKEND_PORT=8000
# 前端 Vite 端口由 DEPLOY_RUN_PORT 决定，本地默认 5000

# ============ CORS ============
CORS_ALLOW_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# ============ 环境标识 ============
APP_ENV=dev
